# Copy this file to ".env" (same folder) and fill in the key.
# The tool reads .env by itself on every run. Never commit or share .env.

# Needed ONLY for picture input (JPG/PNG files, scanned PDF pages).
# PDFs that contain real drawing data work without it.
ANTHROPIC_API_KEY=

# Optional: which vision model reads pictures (default: claude-sonnet-5-5).
# AVCONN_LLM_MODEL=claude-sonnet-5-5
